@EndUserText.label : 'Employee Leave Requests'
@AbapCatalog.enhancement.category : #NOT_EXTENSIBLE
@AbapCatalog.tableCategory : #TRANSPARENT
@AbapCatalog.deliveryClass : #A
@AbapCatalog.dataMaintenance : #RESTRICTED

define table zemp_leave_req {

  key client           : abap.clnt not null;
  key leave_request_id : abap.char(20) not null;
  employee_id          : abap.char(20) not null;
  leave_type           : abap.char(20);
  start_date           : abap.dats;
  end_date             : abap.dats;
  reason               : abap.char(255);
  status               : abap.char(20);
  last_changed_at      : abp_lastchange_tstmpl;

}
